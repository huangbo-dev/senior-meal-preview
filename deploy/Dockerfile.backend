# syntax=docker/dockerfile:1
FROM rust:1.85-slim-bookworm AS builder
WORKDIR /build
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 --create-home --shell /usr/sbin/nologin appuser
WORKDIR /app
COPY --from=builder /build/target/release/senior-meal-preview /usr/local/bin/senior-meal-preview
USER appuser
ENV APP_BIND_ADDR=127.0.0.1
ENV APP_PORT=8787
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/senior-meal-preview"]
