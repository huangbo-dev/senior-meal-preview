# EC2 Rust API Gateway configuration (/etc/senior-meal-preview/backend.env)
# Keep bind address on loopback when Caddy/Nginx terminates TLS on the same EC2 instance.
APP_BIND_ADDR=127.0.0.1
APP_PORT=8787

# Comma-separated HTTPS web origins allowed by CORS on EC2.
APP_ALLOWED_ORIGINS=https://mealpreview.example.com

# Optional Bearer token required from mobile/web clients on /api/v1/* (generate with: openssl rand -hex 32)
APP_API_TOKEN=replace-with-strong-client-bearer-token

# Private GPU worker reachable over Tailscale (100.64.0.0/10 or *.ts.net).
# Leave empty to run in purely symbolic (illustrative_only) mode.
MODEL_WORKER_URL=
MODEL_WORKER_TOKEN=
# Must exceed the worker's WORKER_TIME_BUDGET_SECS (20 s default) and stay under the app's 28 s client timeout.
MODEL_WORKER_TIMEOUT_MS=25000
# The built-in sgedit worker runs one generation at a time; a second concurrent request would queue
# behind the first and time out, so the gateway should answer gpu_busy instead.
MODEL_WORKER_MAX_CONCURRENT=1
