# GPU Server Tailscale Worker configuration (/etc/senior-meal-preview/gpu-worker.env)
# Leave WORKER_BIND_ADDR empty to auto-detect via `tailscale ip -4` (100.64.0.0/10).
WORKER_BIND_ADDR=
WORKER_PORT=8790
WORKER_MODE=dry-run

# Must match MODEL_WORKER_TOKEN on the EC2 Rust backend.
MODEL_WORKER_TOKEN=replace-with-shared-tailscale-worker-secret

# Required when WORKER_MODE=gpu (fails closed with HTTP 503 if neither is configured):
# Built-in sgedit path: <dish_id>/input.png and <dish_id>/mask_rice.png (both 1024x1024) for
# chicken_rice and tofu_rice. Supports one edit per request: brown_rice (T2) or extra_vegetables (T1-B).
WORKER_FIXTURE_DIR=/opt/senior-meal-preview/fixtures
# Checker service: `python -m sgedit.checker serve --port 8781` (must see the same filesystem paths).
WORKER_CHECKER_URL=http://127.0.0.1:8781
# Checkout containing the sgedit package (default: the repository this file's worker lives in).
# The worker must run with the BrushNet environment's Python, with SGEDIT_BASELINE / SGEDIT_WORK set.
# WORKER_SGEDIT_ROOT=
# Generation budget per request (1-8). Each attempt is one edit plus one check; raise the gateway's
# MODEL_WORKER_TIMEOUT_MS to cover it (the 25 s default is too short for 4 attempts).
# WORKER_MAX_ATTEMPTS=4
# Preview PNG longest side returned to the gateway (response limit is 4 MiB).
# WORKER_OUTPUT_MAX_SIDE=768
# Optional: keep every attempt plus run.json (input/mask hashes, policy version, seeds, checker verdicts).
# Unset = nothing is retained. Must be writable by the service user and outside Git.
# WORKER_RUN_DIR=
# Optional external GPU command override (receives request JSON on stdin, outputs GpuArtifact JSON):
# WORKER_GPU_CMD=
